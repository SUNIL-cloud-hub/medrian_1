<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="medrian_1.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>medrian</title>
    <link href="css/style.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <header class="site-header">
  <div class="container">
    <a href="index.html" class="logo">
      <svg class="logo-mark" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="13" cy="13" r="12" stroke="currentColor" stroke-width="1.3" opacity="0.35"/>
        <path d="M2 14.5C6 11 20 11 24 14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        <circle cx="13" cy="10" r="3.2" fill="currentColor" opacity="0.85"/>
      </svg>
      Meridian<em>.</em>
    </a>
    <nav class="nav">
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <ul class="nav-links">
        <li><a href="index.aspx" data-nav="home">Home</a></li>
        <li><a href="about.aspx" data-nav="about">About</a></li>
        <li><a href="contact.aspx" data-nav="contact">Contact</a></li>
      </ul>
     <div class="nav-cta">

    <%
        if (Session["userEmail"] != null)
        {
    %>

        <a href="AdminDashboard.aspx" class="btn btn-ghost">Dashboard</a>
        <a href="Logout.aspx" class="btn btn-outline">Logout</a>

    <%
        }
        else
        {
    %>

        <a href="login.aspx" class="btn btn-ghost">Log in</a>
        <a href="register.aspx" class="btn btn-outline">Sign up</a>

    <%
        }
    %>
</div>
    </nav>
  </div>
</header>

    <form id="form1" runat="server">
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

    </form>
    <footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="index.html" class="logo">
          <svg class="logo-mark" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="13" cy="13" r="12" stroke="currentColor" stroke-width="1.3" opacity="0.35"/>
            <path d="M2 14.5C6 11 20 11 24 14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            <circle cx="13" cy="10" r="3.2" fill="currentColor" opacity="0.85"/>
          </svg>
          Meridian<em>.</em>
        </a>
        <p>Slow, considered travel guidance for people who'd rather wander well than rush everywhere.</p>
      </div>
      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          <li><a href="index.html">Home</a></li>
          <li><a href="about.html">About</a></li>
          <li><a href="contact.html">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Account</h4>
        <ul>
          <li><a href="login.html">Log in</a></li>
          <li><a href="register.html">Sign up</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Contact</h4>
        <ul>
          <li><a href="mailto:hello@meridiantravel.co">hello@meridiantravel.co</a></li>
          <li><a href="tel:+18005551212">+1 (800) 555-1212</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Meridian Travel Co. All rights reserved.</span>
      <div class="socials">
        <a href="#">Instagram</a>
        <a href="#">Pinterest</a>
        <a href="#">Journal</a>
      </div>
    </div>
  </div>
</footer>

<script src="js/script.js"></script>
</body>
</html>

</body>
</html>
